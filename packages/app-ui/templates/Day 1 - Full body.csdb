--- csdb
format: CSDB
version: 2
name: workout.day-1
schemas:
  - public
tables:
  - public.exercises

--- schema:public
name: public
types: {}

--- table:public:exercises
schema: public
name: exercises
columns:
  name: text
  sets: integer
  reps: text
  date: datetime
required:
  - name
  - sets
  - reps
defaults:
  date: now()
formats:
  date: "%Y-%m-%d %H:%M:%S%:z"
visibility:
  date: hidden

--- data:exercises
name,sets,reps,date
Landmine core rotation kneeling,3,12-15,
DB chest press,3,6-8,
BB RDL,3,8-10,
Dual pulley seated cable row,3,8-10,
Cable lateral raise (pulley low),3,8-10,
Bayesian bicep curl,3,10-12,
